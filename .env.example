# Generate unique local API tokens with npm run setup. Never add seed phrases.
HITO_ADMIN_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
HITO_AGENT_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARACTERS
HITO_AGENT_PROJECTS=demo
HITO_DB=.hito/hito.db
HITO_PORT=8787
HITO_ORIGIN=http://127.0.0.1:8787
HITO_MODE=local
HITO_CONTRACT_ID=
HITO_TOKEN_CONTRACT_ID=
