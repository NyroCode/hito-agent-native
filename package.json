{
  "name": "hito-agent-native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-native work agreements and Testnet escrow; no embedded LLM",
  "repository": {
    "type": "git",
    "url": "https://github.com/NyroCode/hito-agent-native.git"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file=.env --experimental-strip-types src/server/main.ts",
    "dev": "node --env-file=.env --experimental-strip-types --watch src/server/main.ts",
    "mcp": "node --env-file=.hito-agent.env --experimental-strip-types src/mcp/main.ts",
    "test": "node --experimental-strip-types --test tests/core/*.test.ts",
    "check": "node scripts/check-syntax.mjs",
    "check:types": "tsc --noEmit",
    "test:adapters": "node --experimental-strip-types --test tests/adapters/*.test.ts",
    "test:browser": "node --experimental-strip-types tests/browser/chromium-e2e.mjs",
    "build:wallet": "node scripts/build-wallet.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "demo:seed": "node --env-file=.env --experimental-strip-types scripts/seed.ts",
    "cli": "node --experimental-strip-types src/cli/main.ts",
    "contract:test": "cargo test --locked --manifest-path contracts/Cargo.toml",
    "contract:build": "node scripts/build-contract.mjs",
    "configure:agent": "node scripts/configure-agent.mjs",
    "doctor": "node --experimental-strip-types scripts/doctor.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@stellar/stellar-sdk": "16.3.0",
    "@stellar/freighter-api": "6.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "typescript": "5.9.3",
    "esbuild": "0.28.2"
  }
}
