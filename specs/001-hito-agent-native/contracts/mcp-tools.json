{
  "description": "Documented JSON schemas; SDK runtime schemas live in src/mcp/main.ts. Runtime handshake and tool calls are covered by tests/adapters/mcp.test.ts.",
  "tools": [
    {
      "name": "hito_get_context",
      "description": "Read projects or scoped work",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "workId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "hito_save_work",
      "description": "Save draft composed by user model",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "workId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "plan": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "deadline": {
                "type": "integer",
                "minimum": 1,
                "description": "Unix seconds; > now and <= now + 366 days enforced by runtime."
              },
              "totalUnits": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "description": "Positive integer token base units; runtime additionally enforces i128 and exact total."
              },
              "milestones": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "amountUnits": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$",
                      "description": "Positive integer token base units; runtime additionally enforces i128 and exact total."
                    },
                    "criteria": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 12,
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          },
                          "evidence": {
                            "enum": [
                              "self_reported",
                              "trusted_ci"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "text",
                          "evidence"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "dependsOn": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                      },
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "amountUnits",
                    "criteria",
                    "dependsOn"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "title",
              "description",
              "deadline",
              "totalUnits",
              "milestones"
            ],
            "additionalProperties": false
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "projectId",
          "plan",
          "idempotencyKey"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "hito_update_progress",
      "description": "Progress, not acceptance",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "milestoneId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "status": {
            "enum": [
              "TODO",
              "IN_PROGRESS",
              "BLOCKED",
              "READY_FOR_REVIEW"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "workId",
          "milestoneId",
          "status",
          "note",
          "idempotencyKey"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "hito_submit_delivery",
      "description": "Self-reported evidence only",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "milestoneId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "artifactHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reference": {
            "type": "string",
            "format": "uri",
            "maxLength": 2000
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "criterionId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                },
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "NOT_CHECKED"
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1500
                }
              },
              "required": [
                "criterionId",
                "status",
                "detail"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 12
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "workId",
          "milestoneId",
          "artifactHash",
          "reference",
          "checks",
          "idempotencyKey"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "hito_check_readiness",
      "description": "Human review readiness, not payment approval",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "milestoneId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          }
        },
        "required": [
          "workId",
          "milestoneId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "hito_prepare_payment",
      "description": "Request only; no address/key/XDR supplied",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "action": {
            "enum": [
              "create",
              "accept",
              "fund",
              "submit",
              "approve",
              "release",
              "request_cancel",
              "cancel",
              "refund_expired",
              "touch"
            ]
          },
          "milestoneId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "evidenceHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "workId",
          "action",
          "idempotencyKey"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "hito_get_payment_status",
      "description": "Read status or reconcile original hash",
      "inputSchema": {
        "type": "object",
        "properties": {
          "intentId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "reconcile": {
            "type": "boolean"
          }
        },
        "required": [
          "intentId"
        ],
        "additionalProperties": false
      }
    }
  ]
}
